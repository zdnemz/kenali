# Build artifacts
/target
**/target/

# Orchestrator run state lives outside the tracked tree
/.crew/

# Debug symbols and crash dumps
*.pdb
*.dmp

# Diagnostics archives exported by the service/UI
*.diag.zip
diagnostics*.zip

# Models are hash-pinned in models/models.lock; weights are never committed
*.onnx
models/*.onnx

# Face data, captures and any biometric material are never committed
*.face
*.facedata
*.capture
faces/
captures/

# Signing material is never committed (injected by CI from secrets)
*.pfx
*.pfx.b64
*.p12

# Local tooling dependencies (Husky hooks); npm install recreates them
node_modules/

# Local NSIS toolchain cache: third-party binaries are never committed.
# Only the README describing provisioning is tracked.
/tools/nsis/*
!/tools/nsis/README.md
